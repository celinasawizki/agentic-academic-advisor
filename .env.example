# Copy to .env (never commit .env).

# Optional. Without a key every agent runs its deterministic fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Student education records are never sent to the LLM unless this is true AND
# an institutional data agreement covers it. Leave false for the hackathon.
LLM_MAY_RECEIVE_STUDENT_RECORDS=false

# Backend
# DATABASE_URL defaults to SQLite at apps/api/academic_planner.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/planner
CORS_ORIGINS=["http://localhost:3000"]

# Real students must upload a graduation plan before schedules are generated;
# the optimizer then schedules only that semester's planned courses.
REQUIRE_GRAD_PLAN=true

# F-1 planning rule (configurable, not legal advice)
F1_FULL_TIME_CREDITS=12
F1_MAX_ONLINE_CREDITS_COUNTED=3
F1_HYBRID_COUNTS_AS_IN_PERSON=false

# Frontend (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
